<Window x:Class="Spock.UI.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parent Authentication" 
        Height="250" 
        Width="400"
        Background="#1A1A1A"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">
    
    <Border Background="#2A2A2A" CornerRadius="8" BorderBrush="#4A9EFF" BorderThickness="2" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" 
                      Text="PARENT ACCESS REQUIRED" 
                      FontSize="18" 
                      FontWeight="Bold"
                      Foreground="#4A9EFF"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,10"/>

            <!-- Description -->
            <TextBlock Grid.Row="1" 
                      Text="This dashboard is password-protected and parent-only." 
                      FontSize="12" 
                      Foreground="#AAA"
                      TextWrapping="Wrap"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"/>

            <!-- Password Label -->
            <TextBlock Grid.Row="2" 
                      Text="Parent Password:" 
                      FontSize="14" 
                      Foreground="#FFF"
                      Margin="0,0,0,5"/>

            <!-- Password Input -->
            <PasswordBox Grid.Row="3" 
                        x:Name="PasswordBox"
                        FontSize="16"
                        Padding="10"
                        Background="#1A1A1A"
                        Foreground="#FFF"
                        BorderBrush="#555"
                        BorderThickness="1"
                        Margin="0,0,0,10"
                        KeyDown="PasswordBox_KeyDown"/>

            <!-- Error Message -->
            <TextBlock Grid.Row="4" 
                      x:Name="ErrorMessage"
                      Text="Incorrect password. Please try again."
                      FontSize="12" 
                      Foreground="#FF4A4A"
                      HorizontalAlignment="Center"
                      Visibility="Collapsed"
                      Margin="0,5,0,0"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="5" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0">
                <Button Content="CANCEL" 
                       Width="100"
                       Padding="10"
                       Margin="0,0,10,0"
                       Click="CancelButton_Click"
                       Background="#3A3A3A"
                       Foreground="#FFF"
                       BorderThickness="0"
                       Cursor="Hand"/>
                <Button Content="UNLOCK" 
                       Width="100"
                       Padding="10"
                       Click="UnlockButton_Click"
                       Background="#4A9EFF"
                       Foreground="#FFF"
                       BorderThickness="0"
                       Cursor="Hand"
                       IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
