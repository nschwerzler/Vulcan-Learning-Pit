<Window x:Class="Spock.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spock.UI"
        xmlns:converters="clr-namespace:Spock.UI.Converters"
        mc:Ignorable="d"
        Title="Vulcan Learning Pit" Height="1000" Width="1400"
        MinHeight="800" MinWidth="1100"
        Background="#1A1A1A"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual">
    
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:DomainToEmojiConverter x:Key="DomainToEmojiConverter"/>
        <converters:DomainToColorConverter x:Key="DomainToColorConverter"/>
        <converters:SecondsToTimeStringConverter x:Key="SecondsToTimeStringConverter"/>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Stats -->
        <Border Grid.Row="0" Background="#2A2A2A" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="VULCAN LEARNING PIT" 
                          FontSize="24" 
                          FontWeight="Bold"
                          Foreground="#4A9EFF"
                          VerticalAlignment="Center"/>

                <!-- Game Token Display (Time Format) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,30,0" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="GAME TIME" FontSize="11" Foreground="#FFD700" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#FFD700" VerticalAlignment="Center"
                                  Text="{Binding GameTokenSeconds, Converter={StaticResource SecondsToTimeStringConverter}}"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                       Content="📊 Parent Dashboard"
                       Click="OpenDashboard_Click"
                       Background="#2A2A2A"
                       Foreground="#888"
                       BorderBrush="#444"
                       Padding="15,5"
                       Margin="0,0,20,0"
                       FontSize="12"
                       Cursor="Hand"
                       VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="1"
                                               CornerRadius="6"
                                               Padding="{TemplateBinding Padding}"
                                               x:Name="border">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="borderScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="border"
                                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                          To="#3A3A3A" Duration="0:0:0.2"/>
                                                            <ColorAnimation Storyboard.TargetName="border"
                                                                          Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                          To="#4A9EFF" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                           Storyboard.TargetProperty="ScaleX"
                                                                           To="1.05" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                           Storyboard.TargetProperty="ScaleY"
                                                                           To="1.05" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="border"
                                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                          To="#2A2A2A" Duration="0:0:0.2"/>
                                                            <ColorAnimation Storyboard.TargetName="border"
                                                                          Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                          To="#444444" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                           Storyboard.TargetProperty="ScaleX"
                                                                           To="1.0" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                           Storyboard.TargetProperty="ScaleY"
                                                                           To="1.0" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                           Storyboard.TargetProperty="ScaleX"
                                                                           To="0.95" Duration="0:0:0.05"/>
                                                            <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                           Storyboard.TargetProperty="ScaleY"
                                                                           To="0.95" Duration="0:0:0.05"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.ToolTip>
                        <ToolTip Content="View detailed progress analytics and parental controls"/>
                    </Button.ToolTip>
                </Button>

                <StackPanel Grid.Column="3" Margin="20,0">
                    <TextBlock Text="STREAK" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CorrectStreak}" 
                              FontSize="28" 
                              FontWeight="Bold"
                              Foreground="#4AFF88"
                              HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="20,0">
                    <TextBlock Text="ACCURACY" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="#FFB84A" HorizontalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F0}%">
                                <Binding Path="AccuracyPercentage"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="20,0">
                    <TextBlock Text="PROBLEMS" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="#CCC" HorizontalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1}">
                                <Binding Path="CorrectAnswers"/>
                                <Binding Path="TotalAttempts"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Controls -->
        <Border Grid.Row="1" Background="#1F1F1F" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Grade Level:" 
                          FontSize="14" 
                          Foreground="#888" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
                
                <ComboBox Grid.Column="1" 
                         ItemsSource="{Binding GradeLevels}"
                         SelectedItem="{Binding SelectedGradeLevel, Mode=TwoWay}"
                         FontSize="14"
                         Background="#3A3A3A"
                         Foreground="#FFFFFF"
                         BorderBrush="#666"
                         BorderThickness="1"
                         Padding="10,8">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton Name="ToggleButton"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                        ClickMode="Press">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}"
                                                               BorderBrush="{TemplateBinding BorderBrush}"
                                                               BorderThickness="{TemplateBinding BorderThickness}"
                                                               CornerRadius="4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition/>
                                                                    <ColumnDefinition Width="20"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Path Grid.Column="1"
                                                                     Data="M 0 0 L 4 4 L 8 0 Z"
                                                                     Fill="#FFFFFF"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <ContentPresenter Name="ContentSite"
                                                            IsHitTestVisible="False"
                                                            Content="{TemplateBinding SelectionBoxItem}"
                                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                            Margin="10,0,30,0"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"/>
                                            <Popup Name="Popup"
                                                  Placement="Bottom"
                                                  IsOpen="{TemplateBinding IsDropDownOpen}"
                                                  AllowsTransparency="True"
                                                  Focusable="False"
                                                  PopupAnimation="Slide">
                                                <Border Background="#3A3A3A"
                                                       BorderBrush="#666"
                                                       BorderThickness="1"
                                                       CornerRadius="4"
                                                       MinWidth="{TemplateBinding ActualWidth}"
                                                       MaxHeight="300">
                                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#3A3A3A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Border"
                                               Background="{TemplateBinding Background}"
                                               BorderBrush="Transparent"
                                               BorderThickness="0"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#4A9EFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#4A9EFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>
                
                <TextBlock Grid.Column="3" Text="Subject:" 
                          FontSize="14" 
                          Foreground="#888" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
                
                <ComboBox Grid.Column="4" 
                         ItemsSource="{Binding Subjects}"
                         SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                         FontSize="14"
                         Background="#3A3A3A"
                         Foreground="#FFFFFF"
                         BorderBrush="#666"
                         BorderThickness="1"
                         Padding="10,8">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton Name="ToggleButton"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                        ClickMode="Press">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}"
                                                               BorderBrush="{TemplateBinding BorderBrush}"
                                                               BorderThickness="{TemplateBinding BorderThickness}"
                                                               CornerRadius="4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition/>
                                                                    <ColumnDefinition Width="20"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Path Grid.Column="1"
                                                                     Data="M 0 0 L 4 4 L 8 0 Z"
                                                                     Fill="#FFFFFF"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <ContentPresenter Name="ContentSite"
                                                            IsHitTestVisible="False"
                                                            Content="{TemplateBinding SelectionBoxItem}"
                                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                            Margin="10,0,30,0"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"/>
                                            <Popup Name="Popup"
                                                  Placement="Bottom"
                                                  IsOpen="{TemplateBinding IsDropDownOpen}"
                                                  AllowsTransparency="True"
                                                  Focusable="False"
                                                  PopupAnimation="Slide">
                                                <Border Background="#3A3A3A"
                                                       BorderBrush="#666"
                                                       BorderThickness="1"
                                                       CornerRadius="4"
                                                       MinWidth="{TemplateBinding ActualWidth}"
                                                       MaxHeight="300">
                                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#3A3A3A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Border"
                                               Background="{TemplateBinding Background}"
                                               BorderBrush="Transparent"
                                               BorderThickness="0"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#4A9EFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#4A9EFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Spock Message Area -->
        <Border Grid.Row="2" Background="#2A4A2A" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                BorderBrush="#4AFF88" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="◢ SPOCK" 
                          FontSize="12" 
                          Foreground="#4AFF88" 
                          FontWeight="Bold"
                          Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SpockMessage}" 
                          FontSize="18" 
                          Foreground="#E0E0E0"
                          TextWrapping="Wrap"
                          LineHeight="28"/>
            </StackPanel>
        </Border>

        <!-- Problem Area -->
        <Border Grid.Row="3" Background="#2A2A2A" CornerRadius="8" Padding="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Colored Left Border for Category -->
                <Border Grid.Column="0" 
                       Background="{Binding CurrentDomain, Converter={StaticResource DomainToColorConverter}}"
                       CornerRadius="8,0,0,8"/>
                
                <!-- Problem Content -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="40">
                    <StackPanel>
                        <!-- Domain Emoji + Label -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="{Binding CurrentDomain, Converter={StaticResource DomainToEmojiConverter}}" 
                                      FontSize="28" 
                                      Margin="0,0,12,0"
                                      Foreground="#FFF"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentDomain}" 
                                      FontSize="16" 
                                      Foreground="#888"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Question Text -->
                        <TextBlock Text="{Binding CurrentQuestion}" 
                                  FontSize="22" 
                                  Foreground="#FFF"
                                  TextWrapping="Wrap"
                                  LineHeight="34"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Feedback Message -->
        <Border Grid.Row="4" 
                CornerRadius="8" 
                Padding="25" 
                Margin="0,0,0,20"
                Visibility="{Binding FeedbackMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="True">
                            <Setter Property="Background" Value="#1A4A1A"/>
                            <Setter Property="BorderBrush" Value="#4AFF4A"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="False">
                            <Setter Property="Background" Value="#4A1A1A"/>
                            <Setter Property="BorderBrush" Value="#FF4A4A"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Reward Badge/Icon -->
                <Border Width="50" Height="50" CornerRadius="25" 
                       Margin="0,0,15,0"
                       VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="True">
                                    <Setter Property="Background" Value="#4AFF4A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="False">
                                    <Setter Property="Background" Value="#FF4A4A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="32" FontWeight="Bold" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="True">
                                        <Setter Property="Text" Value="✓"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="False">
                                        <Setter Property="Text" Value="✗"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <!-- Feedback Text -->
                <TextBlock Text="{Binding FeedbackMessage}" 
                          FontSize="22" 
                          FontWeight="Bold"
                          VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="True">
                                    <Setter Property="Foreground" Value="#4AFF4A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="False">
                                    <Setter Property="Foreground" Value="#FF4A4A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Answer Input Area -->
        <Border Grid.Row="5" Background="#2A2A2A" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <!-- Multiple Choice Options -->
                <StackPanel Visibility="{Binding IsMultipleChoice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding MultipleChoiceInstruction}" 
                              FontSize="14" 
                              Foreground="#4A9EFF"
                              FontWeight="SemiBold"
                              Margin="0,0,0,15"
                              HorizontalAlignment="Left"/>
                    <ItemsControl ItemsSource="{Binding MultipleChoiceOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" 
                                   Command="{Binding DataContext.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding}"
                                   IsEnabled="{Binding DataContext.IsAnswerSubmitted, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}}"
                                   FontSize="18"
                                   Padding="20,12"
                                   Margin="0,0,0,10"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Background="#1A1A1A"
                                   Foreground="#FFF"
                                   BorderBrush="#555"
                                   BorderThickness="2"
                                   Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                           BorderBrush="{TemplateBinding BorderBrush}"
                                                           BorderThickness="{TemplateBinding BorderThickness}"
                                                           CornerRadius="6"
                                                           Padding="{TemplateBinding Padding}"
                                                           x:Name="border">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform x:Name="borderScale" ScaleX="1" ScaleY="1"/>
                                                        </Border.RenderTransform>
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                         VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetName="border"
                                                                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                      To="#2A2A2A" Duration="0:0:0.15"/>
                                                                        <ColorAnimation Storyboard.TargetName="border"
                                                                                      Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                                      To="#4A9EFF" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                                       Storyboard.TargetProperty="ScaleX"
                                                                                       To="1.02" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                                       Storyboard.TargetProperty="ScaleY"
                                                                                       To="1.02" Duration="0:0:0.15"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetName="border"
                                                                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                      To="#1A1A1A" Duration="0:0:0.15"/>
                                                                        <ColorAnimation Storyboard.TargetName="border"
                                                                                      Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                                      To="#555555" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                                       Storyboard.TargetProperty="ScaleX"
                                                                                       To="1.0" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                                       Storyboard.TargetProperty="ScaleY"
                                                                                       To="1.0" Duration="0:0:0.15"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                                       Storyboard.TargetProperty="ScaleX"
                                                                                       To="0.98" Duration="0:0:0.05"/>
                                                                        <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                                       Storyboard.TargetProperty="ScaleY"
                                                                                       To="0.98" Duration="0:0:0.05"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Background" Value="#333333"/>
                                                            <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>

                <!-- Text Input for Free Response -->
                <Grid Visibility="{Binding IsMultipleChoice, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                              Text="YOUR ANSWER:" 
                          FontSize="14" 
                          Foreground="#888"
                          VerticalAlignment="Center"
                          Margin="0,0,15,0"/>
                    
                    <TextBox Grid.Column="1"
                            Text="{Binding UserAnswer, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="16"
                            Padding="10"
                            Background="#1A1A1A"
                            Foreground="#FFF"
                            BorderBrush="#555"
                            BorderThickness="2"
                            IsEnabled="{Binding IsAnswerSubmitted, Converter={StaticResource InverseBoolConverter}}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SubmitCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </Grid>
        </Border>

        <!-- Submit Button (only for free response) -->
        <Button Grid.Row="6" 
                Content="{Binding SubmitButtonText}"
                Command="{Binding SubmitCommand}"
                FontSize="18"
                FontWeight="Bold"
                Padding="20"
                Background="#4A9EFF"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                       CornerRadius="8"
                                       Padding="{TemplateBinding Padding}"
                                       x:Name="border">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="borderScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="border"
                                                                  Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                  To="#5AAFFF" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                   Storyboard.TargetProperty="ScaleX"
                                                                   To="1.03" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                   Storyboard.TargetProperty="ScaleY"
                                                                   To="1.03" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="border"
                                                                  Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                  To="#4A9EFF" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                   Storyboard.TargetProperty="ScaleX"
                                                                   To="1.0" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                   Storyboard.TargetProperty="ScaleY"
                                                                   To="1.0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="border"
                                                                  Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                  To="#3A7FDF" Duration="0:0:0.05"/>
                                                    <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                   Storyboard.TargetProperty="ScaleX"
                                                                   To="0.97" Duration="0:0:0.05"/>
                                                    <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                   Storyboard.TargetProperty="ScaleY"
                                                                   To="0.97" Duration="0:0:0.05"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                   Storyboard.TargetProperty="ScaleX"
                                                                   To="1.03" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="borderScale"
                                                                   Storyboard.TargetProperty="ScaleY"
                                                                   To="1.03" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#555555"/>
                                        <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
