<Window x:Class="Spock.UI.ParentDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spock.UI"
        mc:Ignorable="d"
        Title="Parent Dashboard - Vulcan Learning Pit" Height="800" Width="1200"
        Background="#1A1A1A"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#CC000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Loading Dashboard Data..." 
                          FontSize="24" 
                          Foreground="#4A9EFF" 
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2A2A2A" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PARENT DASHBOARD" 
                              FontSize="28" 
                              FontWeight="Bold"
                              Foreground="#4A9EFF"/>
                    <TextBlock Text="Real-time student progress monitoring and analytics" 
                              FontSize="14" 
                              Foreground="#888"
                              Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="REFRESH DATA" 
                           Style="{StaticResource AnimatedButtonStyle}"
                           Padding="20,10"
                           Margin="0,0,10,0"
                           Command="{Binding RefreshCommand}"/>
                    <Button Content="SETTINGS" 
                           Style="{StaticResource AnimatedButtonStyle}"
                           Padding="20,10"
                           Command="{Binding SettingsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" 
                    Background="Transparent"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" 
                                       Background="#2A2A2A" 
                                       BorderThickness="0"
                                       CornerRadius="8,8,0,0"
                                       Padding="20,10"
                                       Margin="0,0,5,0">
                                    <ContentPresenter ContentSource="Header" 
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#353535"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#CCC"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>

            <!-- Overview Tab -->
            <TabItem Header="OVERVIEW">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Key Metrics Cards -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sessions This Week -->
                            <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="SESSIONS THIS WEEK" FontSize="12" Foreground="#888"/>
                                    <TextBlock Text="{Binding SessionsThisWeek}" 
                                             FontSize="36" 
                                             FontWeight="Bold"
                                             Foreground="#4A9EFF"
                                             Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding SessionsChange}" 
                                             FontSize="12" 
                                             Foreground="#4AFF88"
                                             Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Average Accuracy -->
                            <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="AVERAGE ACCURACY" FontSize="12" Foreground="#888"/>
                                    <TextBlock FontSize="36" FontWeight="Bold" Foreground="#4AFF88" Margin="0,10,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:F0}%">
                                                <Binding Path="AverageAccuracy"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding AccuracyChange}" 
                                             FontSize="12" 
                                             Foreground="#4AFF88"
                                             Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Focus Score -->
                            <Border Grid.Column="2" Background="#2A2A2A" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="FOCUS SCORE" FontSize="12" Foreground="#888"/>
                                    <TextBlock FontSize="36" FontWeight="Bold" Foreground="#FFB84A" Margin="0,10,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:F1}/10">
                                                <Binding Path="FocusScore"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="Consistency in timing" 
                                             FontSize="12" 
                                             Foreground="#888"
                                             Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Weaknesses Resolved -->
                            <Border Grid.Column="3" Background="#2A2A2A" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="WEAKNESSES RESOLVED" FontSize="12" Foreground="#888"/>
                                    <TextBlock Text="{Binding WeaknessesResolved}" 
                                             FontSize="36" 
                                             FontWeight="Bold"
                                             Foreground="#4AFF88"
                                             Margin="0,10,0,0"/>
                                    <TextBlock Text="This month" 
                                             FontSize="12" 
                                             Foreground="#888"
                                             Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Recent Activity -->
                        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="RECENT ACTIVITY" 
                                         FontSize="16" 
                                         FontWeight="Bold"
                                         Foreground="#FFF"
                                         Margin="0,0,0,15"/>
                                
                                <ItemsControl ItemsSource="{Binding RecentSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1A1A" 
                                                   CornerRadius="4" 
                                                   Padding="15" 
                                                   Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" 
                                                             Text="{Binding StartTime, StringFormat='MMM dd, h:mm tt'}" 
                                                             FontSize="14" 
                                                             Foreground="#888"
                                                             Width="150"/>
                                                    
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ProblemsCompleted}" 
                                                                 FontSize="14" 
                                                                 FontWeight="Bold"
                                                                 Foreground="#4A9EFF"
                                                                 Margin="0,0,5,0"/>
                                                        <TextBlock Text="problems · " 
                                                                 FontSize="14" 
                                                                 Foreground="#888"/>
                                                        <TextBlock FontSize="14" Foreground="#4AFF88" Margin="0,0,5,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F0}% accuracy">
                                                                    <Binding Path="Accuracy"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Text=" · " 
                                                                 FontSize="14" 
                                                                 Foreground="#888"/>
                                                        <TextBlock Text="{Binding DomainsVisited}" 
                                                                 FontSize="14" 
                                                                 Foreground="#FFB84A"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" 
                                                             Text="{Binding Duration}" 
                                                             FontSize="14" 
                                                             Foreground="#888"
                                                             Margin="20,0"/>
                                                    
                                                    <TextBlock Grid.Column="3" 
                                                             Text="{Binding ApprovalsReceived, StringFormat='{}{0} approvals'}" 
                                                             FontSize="14" 
                                                             FontWeight="Bold"
                                                             Foreground="#4AFF88"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Domain Progress -->
                        <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="DOMAIN PROGRESS" 
                                         FontSize="16" 
                                         FontWeight="Bold"
                                         Foreground="#FFF"
                                         Margin="0,0,0,15"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Math -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Mathematics" FontSize="14" Foreground="#CCC" Margin="0,0,0,5"/>
                                        <ProgressBar Height="8" 
                                                   Value="{Binding MathProgress}" 
                                                   Maximum="100"
                                                   Foreground="#4A9EFF"
                                                   Background="#1A1A1A"/>
                                        <TextBlock Text="{Binding MathLevel}" 
                                                 FontSize="12" 
                                                 Foreground="#888"
                                                 Margin="0,5,0,20"/>

                                        <!-- Logic -->
                                        <TextBlock Text="Logic &amp; Reasoning" FontSize="14" Foreground="#CCC" Margin="0,0,0,5"/>
                                        <ProgressBar Height="8" 
                                                   Value="{Binding LogicProgress}" 
                                                   Maximum="100"
                                                   Foreground="#4AFF88"
                                                   Background="#1A1A1A"/>
                                        <TextBlock Text="{Binding LogicLevel}" 
                                                 FontSize="12" 
                                                 Foreground="#888"
                                                 Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Reading & Science -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Reading &amp; Comprehension" FontSize="14" Foreground="#CCC" Margin="0,0,0,5"/>
                                        <ProgressBar Height="8" 
                                                   Value="{Binding ReadingProgress}" 
                                                   Maximum="100"
                                                   Foreground="#FFB84A"
                                                   Background="#1A1A1A"/>
                                        <TextBlock Text="{Binding ReadingLevel}" 
                                                 FontSize="12" 
                                                 Foreground="#888"
                                                 Margin="0,5,0,20"/>

                                        <!-- Science -->
                                        <TextBlock Text="Science Thinking" FontSize="14" Foreground="#CCC" Margin="0,0,0,5"/>
                                        <ProgressBar Height="8" 
                                                   Value="{Binding ScienceProgress}" 
                                                   Maximum="100"
                                                   Foreground="#9B59D0"
                                                   Background="#1A1A1A"/>
                                        <TextBlock Text="{Binding ScienceLevel}" 
                                                 FontSize="12" 
                                                 Foreground="#888"
                                                 Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Weaknesses Tab -->
            <TabItem Header="WEAKNESSES">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Active Weaknesses -->
                        <Border Grid.Row="0" Background="#2A2A2A" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="ACTIVE WEAKNESSES" 
                                         FontSize="16" 
                                         FontWeight="Bold"
                                         Foreground="#FFF"
                                         Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Skills currently below 75% accuracy or requiring attention" 
                                         FontSize="12" 
                                         Foreground="#888"
                                         Margin="0,0,0,20"/>

                                <ItemsControl ItemsSource="{Binding ActiveWeaknesses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1A1A" 
                                                   CornerRadius="4" 
                                                   Padding="15" 
                                                   Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" 
                                                                 Text="{Binding SkillName}" 
                                                                 FontSize="14" 
                                                                 FontWeight="Bold"
                                                                 Foreground="#FFF"/>
                                                        
                                                        <TextBlock Grid.Column="1" 
                                                                 FontSize="14" 
                                                                 FontWeight="Bold"
                                                                 Foreground="#FF4A4A">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F0}% accuracy">
                                                                    <Binding Path="Accuracy"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>

                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                                        <TextBlock Text="{Binding AttemptsCount, StringFormat='{}{0} attempts'}" 
                                                                 FontSize="12" 
                                                                 Foreground="#888"
                                                                 Margin="0,0,20,0"/>
                                                        <TextBlock Text="{Binding ErrorPattern}" 
                                                                 FontSize="12" 
                                                                 Foreground="#FFB84A"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Recent Conquests -->
                        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="RECENT CONQUESTS" 
                                         FontSize="16" 
                                         FontWeight="Bold"
                                         Foreground="#FFF"
                                         Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Skills mastered in the last 30 days" 
                                         FontSize="12" 
                                         Foreground="#888"
                                         Margin="0,0,0,20"/>

                                <ItemsControl ItemsSource="{Binding RecentConquests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A3A1A" 
                                                   BorderBrush="#4AFF88"
                                                   BorderThickness="1"
                                                   CornerRadius="4" 
                                                   Padding="15" 
                                                   Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding SkillName}" 
                                                                 FontSize="14" 
                                                                 FontWeight="Bold"
                                                                 Foreground="#4AFF88"/>
                                                        <TextBlock Text="{Binding MasteredDate, StringFormat='Mastered on {0:MMM dd}'}" 
                                                                 FontSize="12" 
                                                                 Foreground="#888"
                                                                 Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" 
                                                             FontSize="14" 
                                                             FontWeight="Bold"
                                                             Foreground="#4AFF88"
                                                             VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:F0}%">
                                                                <Binding Path="FinalAccuracy"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="SETTINGS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="#2A2A2A" CornerRadius="8" Padding="30" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="PARENTAL CONTROLS" 
                                     FontSize="20" 
                                     FontWeight="Bold"
                                     Foreground="#FFF"
                                     Margin="0,0,0,20"/>

                            <!-- Session Length Cap -->
                            <TextBlock Text="Session Length Cap (minutes)" 
                                     FontSize="14" 
                                     Foreground="#CCC"
                                     Margin="0,0,0,10"/>
                            <Slider Value="{Binding SessionLengthCap}" 
                                   Minimum="10" 
                                   Maximum="60" 
                                   TickFrequency="5"
                                   IsSnapToTickEnabled="True"
                                   Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SessionLengthCap, StringFormat='{}{0} minutes'}" 
                                     FontSize="12" 
                                     Foreground="#888"
                                     Margin="0,0,0,30"/>

                            <!-- Max Sessions Per Day -->
                            <TextBlock Text="Maximum Sessions Per Day" 
                                     FontSize="14" 
                                     Foreground="#CCC"
                                     Margin="0,0,0,10"/>
                            <Slider Value="{Binding MaxSessionsPerDay}" 
                                   Minimum="1" 
                                   Maximum="10" 
                                   TickFrequency="1"
                                   IsSnapToTickEnabled="True"
                                   Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding MaxSessionsPerDay, StringFormat='{}{0} sessions'}" 
                                     FontSize="12" 
                                     Foreground="#888"
                                     Margin="0,0,0,30"/>

                            <!-- Acceleration Allowed -->
                            <CheckBox Content="Allow Automatic Acceleration" 
                                    IsChecked="{Binding AccelerationAllowed}"
                                    FontSize="14"
                                    Foreground="#CCC"
                                    Margin="0,0,0,10"/>
                            <TextBlock Text="Enable system to automatically advance to higher grade levels when mastery is demonstrated" 
                                     FontSize="12" 
                                     Foreground="#888"
                                     Margin="25,0,0,30"/>

                            <!-- Dashboard Notifications -->
                            <CheckBox Content="Enable Dashboard Notifications" 
                                    IsChecked="{Binding DashboardNotifications}"
                                    FontSize="14"
                                    Foreground="#CCC"
                                    Margin="0,0,0,10"/>
                            <TextBlock Text="Receive alerts for significant milestones and achievements" 
                                     FontSize="12" 
                                     Foreground="#888"
                                     Margin="25,0,0,30"/>

                            <!-- Save Button -->
                            <Button Content="SAVE SETTINGS" 
                                   Style="{StaticResource AnimatedButtonStyle}"
                                   HorizontalAlignment="Left"
                                   Padding="40,15"
                                   Command="{Binding SaveSettingsCommand}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
