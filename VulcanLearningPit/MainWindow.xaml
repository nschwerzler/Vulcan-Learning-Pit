<Window x:Class="VulcanLearningPit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VulcanLearningPit"
        xmlns:vm="clr-namespace:VulcanLearningPit.ViewModels"
        mc:Ignorable="d"
        Title="Vulcan Learning Pit" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#00d4ff"/>
            <Setter Property="BorderBrush" Value="#00d4ff"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00d4ff"/>
                    <Setter Property="Foreground" Value="#1a1a2e"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="Foreground" Value="#00d4ff"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="MentorStyle">
            <Setter Property="Foreground" Value="#00d4ff"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#00d4ff"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#00d4ff"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0f3460" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="VULCAN LEARNING PIT" 
                          FontSize="28" FontWeight="Bold" 
                          Foreground="#00d4ff" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="🏆 Leaderboard" 
                       Command="{Binding ShowLeaderboardCommand}"
                       Margin="0,0,20,0"
                       Padding="15,8"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="⭐ Tokens: " Foreground="#ffd700" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalTokens}" Foreground="#ffd700" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="📊 Score: " Foreground="#00ff88" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalScore}" Foreground="#00ff88" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mentor Avatar and Message -->
        <Border Grid.Row="1" Background="#16213e" Padding="20" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="80" Height="80" 
                       CornerRadius="40" Background="#0f3460" 
                       BorderBrush="#00d4ff" BorderThickness="3"
                       Margin="0,0,20,0">
                    <TextBlock Text="🖖" FontSize="48" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"/>
                </Border>

                <Border Grid.Column="1" Background="#0f3460" 
                       Padding="15" CornerRadius="10">
                    <TextBlock Text="{Binding MentorMessage}" 
                              Style="{StaticResource MentorStyle}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="10">
            <!-- Setup Panel (visible when session not active) -->
            <Border Background="#16213e" Padding="30" CornerRadius="10">
                <Border.Visibility>
                    <Binding Path="IsSessionActive">
                        <Binding.Converter>
                            <local:InverseBooleanToVisibilityConverter/>
                        </Binding.Converter>
                    </Binding>
                </Border.Visibility>
                
                <StackPanel VerticalAlignment="Center" MaxWidth="500">
                    <TextBlock Text="Begin Your Training" 
                              Style="{StaticResource HeaderStyle}" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,30"/>

                    <TextBlock Text="Name:" Foreground="#e0e0e0" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding StudentName, UpdateSourceTrigger=PropertyChanged}" 
                            Margin="0,0,0,20"/>

                    <TextBlock Text="Grade Level:" Foreground="#e0e0e0" FontSize="14" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableGrades}" 
                             SelectedItem="{Binding SelectedGrade}"
                             Margin="0,0,0,30"/>

                    <Button Content="START TRAINING SESSION" 
                           Command="{Binding StartSessionCommand}"
                           HorizontalAlignment="Center"
                           MinWidth="250"/>
                </StackPanel>
            </Border>

            <!-- Problem Panel (visible during session) -->
            <Grid>
                <Grid.Visibility>
                    <Binding Path="IsSessionActive" Converter="{StaticResource BoolToVisibilityConverter}"/>
                </Grid.Visibility>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Problem Info Bar -->
                <Border Grid.Row="0" Background="#16213e" Padding="15" CornerRadius="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Subject: " Foreground="#e0e0e0" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentSubject}" Foreground="#00d4ff" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="  |  " Foreground="#e0e0e0" FontSize="16" Margin="10,0"/>
                            <TextBlock Text="{Binding DifficultyDisplay}" Foreground="#ffa500" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                            <TextBlock Text="⏱ Time: " Foreground="#ff4444" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TimeRemaining}" Foreground="#ff4444" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="s" Foreground="#ff4444" FontSize="16" FontWeight="Bold" Margin="2,0,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Switch Subject" 
                               Command="{Binding SwitchSubjectCommand}"
                               Padding="10,5"/>
                    </Grid>
                </Border>

                <!-- Problem Content -->
                <Border Grid.Row="1" Background="#16213e" Padding="30" CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Reading Passage (if applicable) -->
                            <Border Background="#0f3460" Padding="15" CornerRadius="5" Margin="0,0,0,20"
                                   Visibility="{Binding ShowPassage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding PassageText}" 
                                          Foreground="#e0e0e0" 
                                          FontSize="14" 
                                          TextWrapping="Wrap"
                                          LineHeight="24"/>
                            </Border>

                            <!-- Question -->
                            <TextBlock Text="{Binding QuestionText}" 
                                      Foreground="#00d4ff" 
                                      FontSize="20" 
                                      FontWeight="Bold"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,30"/>

                            <!-- Answer Options -->
                            <ItemsControl ItemsSource="{Binding AnswerOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding}" 
                                                   GroupName="Answers"
                                                   Margin="0,5"
                                                   FontSize="16">
                                            <RadioButton.Tag>
                                                <Binding/>
                                            </RadioButton.Tag>
                                            <RadioButton.CommandParameter>
                                                <Binding/>
                                            </RadioButton.CommandParameter>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Feedback -->
                            <Border Background="#0f3460" Padding="15" CornerRadius="5" Margin="0,30,0,0"
                                   Visibility="{Binding Feedback, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="{Binding Feedback}" 
                                          Foreground="#e0e0e0" 
                                          FontSize="14"
                                          TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Action Buttons -->
                <Border Grid.Row="2" Background="#16213e" Padding="15" CornerRadius="10" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="SUBMIT ANSWER" 
                               Command="{Binding SubmitAnswerCommand}"
                               Margin="0,0,15,0"
                               MinWidth="150"/>
                        <Button Content="NEXT PROBLEM" 
                               Command="{Binding NextProblemCommand}"
                               Margin="0,0,15,0"
                               MinWidth="150"/>
                        <Button Content="END SESSION" 
                               Command="{Binding EndSessionCommand}"
                               MinWidth="150"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#0f3460" Padding="15">
            <TextBlock Text="Live long and prosper. 🖖" 
                      Foreground="#00d4ff" 
                      FontSize="12" 
                      HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
